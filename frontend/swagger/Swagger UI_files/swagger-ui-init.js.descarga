                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Lista de pedidos"
            }
          },
          "security": [
            {
              "bearer": []
            }
          ],
          "summary": "Listar pedidos con filtros (panel despacho + historial). Restringido por sucursal.",
          "tags": [
            "orders"
          ]
        }
