    "info": {
      "title": "Wonder Chicken API",
      "description": "Backend del sistema de ventas Wonder Chicken V1",
      "version": "1.0",
      "contact": {}
    },
    "tags": [],
    "servers": [],
    "components": {
      "securitySchemes": {
        "bearer": {
          "scheme": "bearer",
          "bearerFormat": "JWT",
          "type": "http"
        }
      },
      "schemas": {
        "LoginDto": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "example": "superadmin@gmail.com",
              "description": "Email del usuario para login"
            },
            "password": {
              "type": "string",
              "example": "password123",
              "minLength": 6
            }
          },
          "required": [
            "email",
            "password"
          ]
        },
        "CreateUserDto": {
          "type": "object",
          "properties": {
            "firstName": {
              "type": "string",
              "example": "Jhonny"
            },
            "lastName": {
              "type": "string",
              "example": "Hurtado Zardan"
            },
            "email": {
              "type": "string",
              "example": "admin1@gmail.com"
            },
            "phone": {
              "type": "string",
              "example": "+591 70000000"
            },
            "ci": {
              "type": "string",
              "example": "ADMIN-001"
            },
            "role": {
              "type": "string",
              "enum": [
                "SUPER_ADMIN",
                "ADMIN",
                "CASHIER",
                "DISPATCHER",
                "COOK"
              ],
              "example": "ADMIN"
            },
            "branchId": {
              "type": "string",
              "description": "Sucursal asignada (null para SUPER_ADMIN)",
              "example": "11111111-1111-1111-1111-111111111111"
            }
          },
          "required": [
            "firstName",
            "lastName",
            "email",
            "ci",
            "role"
          ]
        },
        "UpdateUserDto": {
          "type": "object",
          "properties": {
            "firstName": {
              "type": "string",
              "example": "Jhonny"
            },
            "lastName": {
              "type": "string",
              "example": "Hurtado Zardan"
            },
            "email": {
              "type": "string",
              "example": "admin1@gmail.com"
            },
            "phone": {
              "type": "string",
              "example": "+591 70000000"
            },
            "ci": {
              "type": "string",
              "example": "ADMIN-001"
            },
            "role": {
              "type": "string",
              "enum": [
                "SUPER_ADMIN",
                "ADMIN",
                "CASHIER",
                "DISPATCHER",
                "COOK"
              ],
              "example": "ADMIN"
            },
            "branchId": {
              "type": "string",
              "description": "Sucursal asignada (null para SUPER_ADMIN)",
              "example": "11111111-1111-1111-1111-111111111111"
            }
          }
        },
        "CreateBranchDto": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "example": "Sucursal Centro"
            },
            "address": {
              "type": "string",
              "example": "Av. Corrientes 1234, CABA"
            }
          },
          "required": [
            "name",
            "address"
          ]
        },
        "UpdateBranchDto": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "example": "Sucursal Centro"
            },
            "address": {
              "type": "string",
              "example": "Av. Corrientes 1234, CABA"
            }
          }
        },
        "CreateProductDto": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "example": "Porción Media",
              "minLength": 3,
              "maxLength": 80
            },
            "basePrice": {
              "type": "number",
              "example": 30,
              "minimum": 0.01
            },
            "category": {
              "type": "string",
              "example": "Plato principal"
            },
            "description": {
              "type": "string",
              "example": "2 presas + porción mixto"
            },
            "isSellable": {
              "type": "boolean",
              "example": true,
              "default": true
            },
            "isInventoryItem": {
              "type": "boolean",
              "example": true,
              "default": true
            }
          },
          "required": [
            "name",
            "basePrice",
            "category"
          ]
        },
        "VariantComponentDto": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "example": "presa",
              "enum": [
                "presa",
                "acompanamiento",
                "bebida",
                "extra"
              ]
            },
            "name": {
              "type": "string",
              "example": "mixto"
            },
            "count": {
              "type": "number",
              "example": 2,
              "minimum": 1
            }
          },
          "required": [
            "type",
            "count"
          ]
        },
        "CreateVariantDto": {
          "type": "object",
          "properties": {
            "productId": {
              "type": "string",
              "example": "uuid-product-porcion-media",
              "format": "uuid"
            },
            "name": {
              "type": "string",
              "example": "Porción Media - Mixto"
            },
            "components": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/VariantComponentDto"
              }
            },
            "isDefault": {
              "type": "boolean",
              "example": true,
              "default": false
            }
          },
          "required": [
            "productId",
            "name",
            "components"
          ]
        },
        "OpenShiftDto": {
          "type": "object",
          "properties": {
            "openingAmount": {
              "type": "number",
              "example": 200,
              "minimum": 0,
              "maximum": 999999.99
            },
            "cashRegisterId": {
              "type": "string",
              "example": "uuid-cash-register-1",
              "format": "uuid"
            },
            "periodId": {
              "type": "string",
              "example": "uuid-period-manana",
              "format": "uuid"
            }
          },
          "required": [
            "openingAmount",
            "cashRegisterId",
            "periodId"
          ]
        },
        "OrderItemSelectedPieceDto": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "example": "pecho",
              "enum": [
                "pecho",
                "ala",
                "pierna",
                "entrepierna"
              ]
            },
            "qty": {
              "type": "number",
              "example": 2,
              "minimum": 1
            }
          },
          "required": [
            "type",
            "qty"
          ]
        },
        "OrderItemSubstitutionDto": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "example": "mixto",
              "enum": [
                "mixto"
              ]
            },
            "to": {
              "type": "string",
              "example": "arroz",
              "enum": [
                "arroz",
                "papa",
                "smiles",
                "mixto"
              ]
            }
          },
          "required": [
            "from",
            "to"
          ]
        },
        "OrderItemExtraDto": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "example": "papa"
            },
            "qty": {
              "type": "number",
              "example": 1,
              "minimum": 1
            }
          },
          "required": [
            "type",
            "qty"
          ]
        },
        "OrderItemDrinkDto": {
          "type": "object",
          "properties": {
            "productId": {
              "type": "string",
              "example": "uuid-product-fanta",
              "format": "uuid"
            },
            "qty": {
              "type": "number",
              "example": 1,
              "minimum": 1
            }
          },
          "required": [
            "productId",
            "qty"
          ]
        },
        "CreateOrderItemDto": {
          "type": "object",
          "properties": {
            "productId": {
              "type": "string",
              "example": "uuid-product-wonder",
              "format": "uuid"
            },
            "variantId": {
              "type": "string",
              "example": "uuid-variant-wonder",
              "format": "uuid"
            },
            "quantity": {
              "type": "number",
              "example": 2,
              "minimum": 1
            },
            "selectedPieces": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/OrderItemSelectedPieceDto"
              }
            },
            "substitutions": {
              "maxItems": 1,
              "description": "Máximo 1 por ítem. NO afecta el precio (PDR §2.1).",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/OrderItemSubstitutionDto"
              }
            },
            "extras": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/OrderItemExtraDto"
              }
            },
            "drinks": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/OrderItemDrinkDto"
              }
            },
            "notes": {
              "type": "string",
              "example": "Sin sal"
            }
          },
          "required": [
            "productId",
            "quantity"
          ]
        },
        "CreateOrderDto": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "MESA",
                "LLEVAR"
              ],
              "example": "MESA"
            },
            "tableNumber": {
              "type": "string",
              "example": "70",
              "description": "Número de mesa (opcional, solo informativo para type=MESA)"
            },
            "customerId": {
              "type": "string",
              "example": "uuid-customer-001",
              "format": "uuid"
            },
            "paymentStatus": {
              "type": "string",
              "enum": [
                "PENDING",
                "PAID",
                "PARTIAL"
              ],
              "example": "PAID"
            },
            "paymentMethod": {
              "type": "string",
              "enum": [
                "CASH",
                "CARD",
                "VALE"
              ],
              "example": "CASH",
              "description": "Requerido si paymentStatus=PAID"
            },
            "items": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/CreateOrderItemDto"
              }
            }
          },
          "required": [
            "type",
            "paymentStatus",
            "items"
          ]
        },
        "PayOrderDto": {
          "type": "object",
          "properties": {
            "paymentMethod": {
              "type": "string",
              "enum": [
                "CASH",
                "CARD",
                "VALE"
              ],
              "example": "CASH"
            }
          },
          "required": [
            "paymentMethod"
          ]
        }
      }
    }
  },
  "customOptions": {}
};
  url = options.swaggerUrl || url
  let urls = options.swaggerUrls
  let customOptions = options.customOptions
  let spec1 = options.swaggerDoc
  let swaggerOptions = {
    spec: spec1,
    url: url,
    urls: urls,
    dom_id: '#swagger-ui',
    deepLinking: true,
    presets: [
      SwaggerUIBundle.presets.apis,
      SwaggerUIStandalonePreset
    ],
    plugins: [
      SwaggerUIBundle.plugins.DownloadUrl
    ],
    layout: "StandaloneLayout"
  }
  for (let attrname in customOptions) {
    swaggerOptions[attrname] = customOptions[attrname];
  }
  let ui = SwaggerUIBundle(swaggerOptions)

  if (customOptions.initOAuth) {
    ui.initOAuth(customOptions.initOAuth)
  }

  if (customOptions.authAction) {
    ui.authActions.authorize(customOptions.authAction)
  }
  
  window.ui = ui
}
