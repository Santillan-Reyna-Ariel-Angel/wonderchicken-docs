                  "DELIVERED",
                  "CLOSED",
                  "PENDING_PAYMENT",
                  "CANCELLED",
                  "ON_HOLD"
                ]
              }
            },
            {
              "name": "date",
              "required": false,
              "in": "query",
              "description": "Fecha del día (ISO)",
              "schema": {
                "format": "date-time",
                "example": "2026-05-01",
                "type": "string"
              }
            },
            {
              "name": "createdBy",
              "required": false,
