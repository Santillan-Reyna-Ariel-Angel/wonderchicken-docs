// Wonder Chicken — Sistema de Ventas
// Schema basado en docs/technical_guide.md §3 (fuente de verdad del modelo) + docs/pdr.md §2 (reglas).
//
// Reglas críticas codificadas (NO alterar sin revisar technical_guide §3 / pdr §2):
//   §2.1  Sustituciones NO afectan precio → no existe priceAdjustment
//   §2.3  Inventario COCIDO decrementa al pagar (paymentStatus = PAID), no en preparing.
//         Ciclo CRUDO de presas por turno se modela aparte en ShiftChickenLog.
//   §2.5  pendingPayment se prepara igual; cancelación SIEMPRE manual (sin timeout)
//   §2.7  Permisos enforced en backend (JWT + guard por rol + branch). La UI no es la frontera.
//         Multi-sucursal: SUPER_ADMIN tiene acceso global, otros roles restringidos a su branchId.
//   §2.8  Order.type ∈ {MESA, LLEVAR}. CUSTOM NO es un type — es Order.isCustom = true.
//         Order.orderNumber = número humano pantalla pública "turnos de banco" (FR-007),
//         distinto de Order.publicToken = credencial vista privada del cliente (FR-015).
//   §2.10 Ventas custom: endpoint dedicado, item con customPieces, precio confirmado por cajera.
//         InventoryItem.salePrice (por presa) alimenta el precio sugerido custom.
//   §2.11 Descuentos = catálogo Discount (monto fijo POR PLATO) + DiscountAuthorization (por turno).
//         El descuento se aplica POR PLATO, a nivel OrderItem (la cajera marca qué ítems lo llevan).
//         OrderItem.discountAmount es SNAPSHOT del monto fijo por unidad; los totales son derivados.
//         Máximo UN descuento por ítem (sin apilamiento). NO existe internalDiscount.
//   §2.12 Customer = facturación nominada OPCIONAL (Order.customerId nullable → "S/N" si anónimo).
//         Customer.passwordHash añadido para habilitar login de clientes en futuras fases.
//   §13.3 Shift.periodId se DECLARA al abrir el turno (catálogo ShiftPeriod), NUNCA se infiere
//         del reloj ni de una API de hora. AuditLog.shiftId hace que el log nazca sabiendo su
//         turno (null = acción de admin fuera de caja) — consulta por turno sin ventanas horarias.

// ============================================================================
// BRANCH (Multi-sucursal V1)
// ============================================================================

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  address   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  shifts         Shift[]
  cashRegisters  CashRegister[]
  inventoryItems InventoryItem[]

  @@map("branches")
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url se configura en prisma.config.ts (Prisma 7+)
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CASHIER
  DISPATCHER
  COOK
}

enum OrderType {
  // CUSTOM NO va acá — ver Order.isCustom (§2.10)
  MESA
  LLEVAR
}

enum OrderStatus {
  CREATED
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CLOSED
  PENDING_PAYMENT
  CANCELLED
  ON_HOLD
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
}

enum PaymentMethod {
  CASH
  CARD
  VALE
}

enum InventoryUnit {
  PRESA
  BOLSA
  PAQUETE
  UNIDAD
  VASO
  DOYPACK
}

enum InventoryItemType {
  PECHO
  ALA
  PIERNA
  ENTREPIERNA
  BEBIDA
  INSUMO
}

enum InventoryTxnReason {
  // NO hay reason de descuento (§2.11): un descuento es puramente monetario,
  // la venta con descuento descuenta inventario con reason = SALE como cualquier otra.
  SALE
  ADJUSTMENT
  RECEPTION
  VALE
  MANUAL_CONSUMPTION
  CANCELLATION_REVERT
}

enum VoucherStatus {
  ISSUED
  REDEEMED
  CANCELLED
}

enum CustomerSex {
  HOMBRE
  MUJER
}

// always = todo el turno; endOfShift = solo a fin de turno (§2.11)
enum DiscountAvailability {
  ALWAYS
  END_OF_SHIFT
}

// Tipos de presa del ciclo CRUDO por turno (§2.3 / ShiftChickenLog)
enum ChickenPieceType {
  PECHO
  ALA
  PIERNA
  ENTREPIERNA
}

enum ExpensePaidBy {
  CASH
  REGISTER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

// ============================================================================
// USERS & AUTH
// ============================================================================

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)
  // Multi-sucursal: branchId nullable para SUPER_ADMIN (acceso global)
  branchId     String?  @db.Uuid
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shiftsAsCashier        Shift[]                  @relation("ShiftCashier")
  ordersCreated          Order[]                  @relation("OrderCreatedBy")
  ordersDelivered        Order[]                  @relation("OrderDeliveredBy")
  vouchersIssued         Voucher[]                @relation("VoucherIssuedBy")
  vouchersAsWorker       Voucher[]                @relation("VoucherWorker")
  inventoryTxns          InventoryTransaction[]
  manualConsumptions     DailyManualConsumption[]
  shiftChickenLogs       ShiftChickenLog[]
  discountAuthsAsCashier DiscountAuthorization[]  @relation("DiscountAuthCashier")
  discountAuthsAsAdmin   DiscountAuthorization[]  @relation("DiscountAuthAdmin")
  expensesCreated        Expense[]
  auditLogs              AuditLog[]

  @@index([role])
  @@index([active])
  @@index([branchId])
  @@map("users")
}

// ============================================================================
// PRODUCTS & VARIANTS
// ============================================================================

model Product {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  basePrice   Decimal  @db.Decimal(10, 2)
  category    String // "Plato principal" | "Bebida" | "Extra" — string libre p/ no romper si cambia el menú
  description String?
  active      Boolean  @default(true)
  isSellable  Boolean  @default(true)
  isInventoryItem Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants   Variant[]
  orderItems OrderItem[]
  orderItemComponents OrderItemComponent[]
  vouchers   Voucher[]

  @@index([category, active])
  @@map("products")
}

model Variant {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @db.Uuid
  name       String
  // components: [{type:"presa", count:2}, {type:"acompanamiento", name:"mixto", count:1}, ...]
  components Json
  isDefault  Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([productId])
  @@map("variants")
}

// ============================================================================
// ORDERS
// ============================================================================

model Order {
  id          String @id @default(uuid(7)) @db.Uuid
  // Número humano para pantalla pública "turnos de banco" (§2.8 / FR-007).
  // Se REINICIA por turno (1, 2, 3...) — único en combinación con shiftId.
  // Lo asigna la app vía Shift.lastOrderNumber dentro de una $transaction.
  orderNumber Int

  type          OrderType
  tableNumber   String?
  // customerName: snapshot de visualización p/ comanda/factura ("S/N" si anónimo).
  // NO cambia si luego se edita el Customer. customerId agrupa los pedidos del día (§2.12).
  customerName  String?
  // Token aleatorio no adivinable (128 bits, crypto.randomBytes(16)). Credencial de la
  // vista pública del cliente (FR-015) — NO se expone el id interno ni un secuencial.
  publicToken   String         @unique
  status        OrderStatus    @default(CREATED)
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?

  // §2.11 — originalAmount = suma de ítems ANTES de descuento = Σ(unitPrice × quantity).
  // El descuento vive a NIVEL ÍTEM (OrderItem.discountId / discountAmount, por plato).
  // total = derivado: originalAmount − Σ(descuentos de los ítems). Es lo que entra a caja.
  originalAmount Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)
  isCustom       Boolean @default(false) // §2.10 — true si vino por POST /orders/custom

  cancelReason  String?
  cancelDetails String?
  cancelledAt   DateTime?

  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  readyAt     DateTime? // §2.8 — reemplaza NotificationLog
  deliveredAt DateTime?

  createdById   String    @db.Uuid
  createdBy     User      @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deliveredById String?   @db.Uuid
  deliveredBy   User?     @relation("OrderDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)
  shiftId       String    @db.Uuid
  shift         Shift     @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  // §2.12 — cliente registrado (factura nominada); null = venta anónima "S/N"
  customerId    String?   @db.Uuid
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  items OrderItem[]

  @@unique([shiftId, orderNumber]) // numerado reinicia por turno
  @@index([status])
  @@index([paymentStatus])
  @@index([type])
  @@index([isCustom]) // reportes filtran por isCustom (§2.10)
  @@index([customerId]) // vista "pedidos del día" agrupa por customerId (§2.12)
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid(7)) @db.Uuid
  orderId   String  @db.Uuid
  productId String? @db.Uuid // null si pertenece a orden custom (§2.10)
  variantId String? @db.Uuid
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  // Snapshot JSON de la línea al momento de la creación — útil para impresión/auditoría.
  snapshot Json?

  // §2.11 — descuento POR PLATO (nivel ítem). El discountId llega como referencia en el
  // payload de CREACIÓN de la orden (una sola llamada, sin endpoint aparte — tech guide §5.0);
  // el backend valida (disponibilidad + autorización del turno) y congela acá el snapshot.
  // discountAmount = SNAPSHOT del monto fijo POR UNIDAD al aplicarlo (NO una resta);
  // aplica a TODAS las unidades del ítem (para descuento parcial, el POS parte el ítem
  // en dos líneas: N con descuento y M sin). Máximo UN descuento por ítem (sin apilamiento).
  discountId     String?  @db.Uuid
  discountAmount Decimal? @db.Decimal(10, 2)

  // totalPrice = derivado: (unitPrice − (discountAmount ?? 0)) × quantity
  totalPrice Decimal @db.Decimal(10, 2)
  notes      String?

  // [{from:"mixto", to:"arroz"}] — sustituciones (§2.1). NO modifican precio.
  substitutions Json?

  // Presas elegidas en orden ESTÁNDAR: [{type:"pecho", qty:2}, {type:"ala", qty:2}]
  selectedPieces Json?

  // Presas en orden CUSTOM (§2.10): [{type:"pecho", qty:2}, {type:"ala", qty:1}]
  customPieces Json?

  // Acompañamientos opcionales (no afectan inventario granular en MVP)
  extras Json?

  // Bebidas opcionales: [{productId:"...", qty:1}] — sí decrementan inventario
  drinks Json?

  createdAt DateTime @default(now())

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  Variant?  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  discount Discount? @relation(fields: [discountId], references: [id], onDelete: Restrict)

  components OrderItemComponent[]

  @@index([orderId])
  @@index([productId])
  @@index([discountId]) // reportes/arqueo agrupan descuentos aplicados por plato (§2.11)
  @@map("order_items")
}

// ============================================================================
// ORDER ITEM COMPONENTS (operational source of truth for inventory changes)
// ============================================================================

model OrderItemComponent {
  id              String   @id @default(uuid(7)) @db.Uuid
  orderItemId     String   @db.Uuid
  inventoryItemId String?  @db.Uuid
  productId       String?  @db.Uuid
  quantity        Int
  unitPrice       Decimal  @db.Decimal(10, 2)
  label           String?
  createdAt       DateTime @default(now())

  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  product        Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([inventoryItemId])
  @@index([productId])
  @@map("order_item_components")
}

// ============================================================================
// INVENTORY
// ============================================================================

model InventoryItem {
  id           String            @id @default(uuid(7)) @db.Uuid
  productCode  String
  name         String
  unit         InventoryUnit
  type         InventoryItemType
  currentStock Int               @default(0)
  unitMeasure  String? // texto libre: "500 ml", "2 lt", etc.
  // §2.10 — precio de venta unitario. Para type ∈ {PECHO,ALA,PIERNA,ENTREPIERNA} es el
  // precio por presa que alimenta el precio sugerido custom. Solo VENTA (no costo ni margen).
  salePrice    Decimal?          @db.Decimal(10, 2)
  active       Boolean           @default(true)
  // Multi-sucursal: cada ítem de inventario pertenece a una sucursal
  branchId     String            @db.Uuid
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  batches            InventoryBatch[]
  transactions       InventoryTransaction[]
  manualConsumptions DailyManualConsumption[]
  orderItemComponents OrderItemComponent[]

  @@unique([branchId, productCode])
  @@index([type, active])
  @@index([branchId])
  @@map("inventory_items")
}

model InventoryBatch {
  id                String   @id @default(uuid(7)) @db.Uuid
  inventoryItemId   String   @db.Uuid
  batchCode         String
  processedAt       DateTime
  quantityReceived  Int
  quantityRemaining Int
  origin            String? // "fresh" | "reproceso" | "supplier-X"
  createdAt         DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId])
  @@index([batchCode])
  @@map("inventory_batches")
}

model InventoryTransaction {
  id              String             @id @default(uuid(7)) @db.Uuid
  inventoryItemId String             @db.Uuid
  delta           Int // negativo = decremento, positivo = ingreso/reversión
  reason          InventoryTxnReason
  referenceId     String?            @db.Uuid // Order.id | Voucher.id | Expense.id
  note            String?
  timestamp       DateTime           @default(now())

  userId        String        @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, timestamp])
  @@index([reason])
  @@index([referenceId])
  @@map("inventory_transactions")
}

// Bolsas de papa, smile, vasos, bombillas, etc. anotadas al cierre de turno (§2.3 / FR-017)
model DailyManualConsumption {
  id              String   @id @default(uuid(7)) @db.Uuid
  shiftId         String   @db.Uuid
  inventoryItemId String   @db.Uuid
  quantity        Int
  recordedAt      DateTime @default(now())

  recordedById  String        @db.Uuid
  recordedBy    User          @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  shift         Shift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([shiftId])
  @@map("daily_manual_consumptions")
}

// ============================================================================
// VOUCHERS (vales — descuento por nómina, §2.4)
// ============================================================================

model Voucher {
  id             String        @id @default(uuid(7)) @db.Uuid
  code           String        @unique // "V-20260501-001"
  // El trabajador puede ser usuario del sistema (workerId) o no (workerName libre). Al menos uno.
  workerId       String?       @db.Uuid
  workerName     String? // texto libre si el trabajador no es usuario del sistema
  productId      String?       @db.Uuid
  productName    String // snapshot del nombre al momento de emitir
  // §2.4 / §2.11 — originalAmount = precio del producto. discountAmount = snapshot del
  // "Descuento personal" si se aplicó. amount = derivado: originalAmount − (discountAmount ?? 0).
  originalAmount Decimal       @db.Decimal(10, 2)
  discountAmount Decimal?      @db.Decimal(10, 2)
  amount         Decimal       @db.Decimal(10, 2)
  status         VoucherStatus @default(ISSUED)
  note           String?
  issuedAt       DateTime      @default(now())

  issuedById String    @db.Uuid
  issuedBy   User      @relation("VoucherIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  worker     User?     @relation("VoucherWorker", fields: [workerId], references: [id], onDelete: Restrict)
  shiftId    String    @db.Uuid
  shift      Shift     @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Restrict)
  discountId String?   @db.Uuid
  discount   Discount? @relation(fields: [discountId], references: [id], onDelete: Restrict)

  @@index([shiftId])
  @@index([workerId])
  @@index([workerName])
  @@index([issuedAt])
  @@map("vouchers")
}

// ============================================================================
// CASH REGISTER & SHIFTS
// ============================================================================

model CashRegister {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  active    Boolean  @default(true)
  branchId  String   @db.Uuid
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  shifts Shift[]

  @@unique([branchId, name])
  @@map("cash_registers")
}

// Catálogo de períodos de turno ("Mañana", "Noche" — el dueño puede crear "Tarde").
// Es catálogo y NO enum para que un nuevo turno no requiera migración.
// El período se DECLARA al abrir la caja (POST /shifts/open) — el sistema JAMÁS lo
// infiere del reloj: la hora puede estar mal configurada y los horarios cambian.
// referenceStart/End son informativos (nunca clasifican). Descarte de la inferencia
// por hora (reloj o API externa) documentado en pdr §13.3.
model ShiftPeriod {
  id             String   @id @default(uuid(7)) @db.Uuid
  name           String   @unique // "Mañana" | "Noche" | ...
  displayOrder   Int // orden dentro del día (1 = primero)
  referenceStart String? // horario de REFERENCIA informativo (ej. "09:00") — NO clasifica nada
  referenceEnd   String? // ej. "16:00"
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shifts Shift[]

  @@index([active, displayOrder])
  @@map("shift_periods")
}

model Shift {
  id              String      @id @default(uuid(7)) @db.Uuid
  status          ShiftStatus @default(OPEN)
  openingAmount   Decimal     @db.Decimal(10, 2)
  closingAmount   Decimal?    @db.Decimal(10, 2)
  expectedAmount  Decimal?    @db.Decimal(10, 2)
  discrepancy     Decimal?    @db.Decimal(10, 2)
  // Contador de tickets del turno. Se incrementa atómicamente al crear cada Order.
  // El orderNumber asignado a la orden = lastOrderNumber resultante (1, 2, 3...).
  lastOrderNumber Int         @default(0)
  startAt         DateTime    @default(now())
  endAt           DateTime?

  cashierId      String        @db.Uuid
  cashier        User          @relation("ShiftCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  cashRegisterId String?       @db.Uuid
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  // Multi-sucursal: cada turno pertenece a una sucursal
  branchId       String        @db.Uuid
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // Período del turno ("Mañana"/"Noche"/...). Se asigna al ABRIR el turno (preselección
  // sugerida editable) y NUNCA se deriva del reloj. NO es atributo del User: el personal
  // rota días/turnos/roles (§2.7). Política fina de quién confirma → pdr §13.3;
  // agenda semanal (persona→día→turno→rol) → V2 (pdr §13.2).
  periodId       String        @db.Uuid
  period         ShiftPeriod   @relation(fields: [periodId], references: [id], onDelete: Restrict)

  orders                 Order[]
  vouchers               Voucher[]
  expenses               Expense[]
  manualConsumptions     DailyManualConsumption[]
  chickenLogs            ShiftChickenLog[]
  discountAuthorizations DiscountAuthorization[]
  auditLogs              AuditLog[]

  @@index([status])
  @@index([cashierId])
  @@index([startAt])
  @@index([branchId])
  @@index([periodId, startAt]) // consulta de auditoría/arqueo: turnos de una fecha+período
  @@map("shifts")
}

model Expense {
  id          String        @id @default(uuid(7)) @db.Uuid
  description String
  amount      Decimal       @db.Decimal(10, 2)
  paidBy      ExpensePaidBy
  createdAt   DateTime      @default(now())

  shiftId     String @db.Uuid
  shift       Shift  @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  createdById String @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([shiftId])
  @@map("expenses")
}

// ============================================================================
// AUDIT (§2.9 — solo acciones críticas en MVP)
// ============================================================================

model AuditLog {
  id       String @id @default(uuid(7)) @db.Uuid
  // Verbos y entidades: la fuente de verdad es technical_guide §4.3 (tabla de acciones).
  // entity: "Order" | "Voucher" | "InventoryItem" | "Shift" | "DiscountAuthorization" | "Report"
  entity   String
  // Referencia POLIMÓRFICA (apunta a distintas tablas según `entity`) → NO tiene FK, y por eso
  // @db.Uuid no aportaba integridad, solo impedía identificadores no-UUID. Es String:
  //   - entidad persistida → su UUID (ej. "019a3f7c-...")
  //   - entidad lógica ("Report") → clave legible y consultable (ej. "sales:2026-07")
  // Siempre requerido: toda fila de auditoría responde "sobre qué".
  entityId String
  // "CREATE_SALE" | "CANCEL_SALE" | "ADJUST_INVENTORY" | "CREATE_VOUCHER"
  // | "OPEN_SHIFT" | "CLOSE_SHIFT" | "GENERATE_REPORT" | "AUTHORIZE_DISCOUNT"
  action    String
  details   Json?
  timestamp DateTime @default(now())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Turno en el que ocurrió la acción — el log nace sabiendo su turno (sin cálculos
  // de ventana horaria). NULL = acción crítica fuera de una sesión de caja
  // (ADJUST_INVENTORY / GENERATE_REPORT del admin). En OPEN/CLOSE_SHIFT es el propio turno.
  shiftId String? @db.Uuid
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([userId])
  @@index([timestamp])
  @@index([shiftId]) // consulta de auditoría por turno (caja+período vía Shift)
  @@map("audit_logs")
}

// ============================================================================
// CUSTOMERS (§2.12 — facturación nominada OPCIONAL; FR-019)
// ============================================================================

model Customer {
  id           String      @id @default(uuid(7)) @db.Uuid
  ci           String      @unique // cédula — clave de búsqueda
  nit          String? // factura a nombre de empresa; también buscable (el cliente dicta CI o NIT)
  firstName    String
  lastName     String
  sex          CustomerSex
  birthDate    DateTime?   @db.Date // sin hora — una fecha de nacimiento no lleva hora
  phone        String?
  email        String? // la factura electrónica se envía por correo
  passwordHash String? // para habilitar login de clientes en futuras fases
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orders Order[]

  @@index([nit])
  @@index([active])
  @@map("customers")
}

// ============================================================================
// DISCOUNTS (§2.11 — catálogo mínimo, NO motor de reglas)
// ============================================================================

model Discount {
  id                    String               @id @default(uuid(7)) @db.Uuid
  name                  String
  fixedAmount           Decimal              @db.Decimal(10, 2) // monto fijo en Bs POR PLATO — NO porcentaje en V1
  availability          DiscountAvailability
  requiresAuthorization Boolean              @default(false) // si true → necesita DiscountAuthorization por turno
  active                Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  // §2.11 — el descuento se aplica POR PLATO: referencia desde OrderItem, no desde Order
  orderItems     OrderItem[]
  vouchers       Voucher[]
  authorizations DiscountAuthorization[]

  @@index([active])
  @@map("discounts")
}

// Habilitación admin → sesión de cajera para un Discount con requiresAuthorization = true.
// Alcance POR TURNO (no por orden): se extingue al cerrar el turno (§2.11 / FR-016b).
model DiscountAuthorization {
  id             String   @id @default(uuid(7)) @db.Uuid
  discountId     String   @db.Uuid
  shiftId        String   @db.Uuid
  cashierId      String   @db.Uuid // sesión/cajera beneficiada
  authorizedById String   @db.Uuid // admin que la otorgó
  authorizedAt   DateTime @default(now())

  discount     Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  shift        Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  cashier      User     @relation("DiscountAuthCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  authorizedBy User     @relation("DiscountAuthAdmin", fields: [authorizedById], references: [id], onDelete: Restrict)

  @@unique([discountId, shiftId, cashierId]) // una autorización por descuento/sesión/turno
  @@index([shiftId])
  @@map("discount_authorizations")
}

// ============================================================================
// CHICKEN CYCLE (§2.3 — plano CRUDO anotado por el cocinero al cierre; FR-017)
// ============================================================================

model ShiftChickenLog {
  id             String           @id @default(uuid(7)) @db.Uuid
  shiftId        String           @db.Uuid
  pieceType      ChickenPieceType
  reprocessRaw   Int // crudo sobrante del turno anterior — autopoblado con rawLeftover del log previo
  processedRaw   Int // pollo fresco marinado en este turno
  rawLeftover    Int // sobrante procesado crudo al cierre → reprocessRaw del turno T+1
  cookedLeftover Int // sobrante cocido en expositor → habilita descuento al personal (§2.11)
  recordedAt     DateTime         @default(now())
  closedAt       DateTime?
  // Cantidad cocinada (derivada, NO se almacena): reprocessRaw + processedRaw − rawLeftover

  recordedById String @db.Uuid
  recordedBy   User   @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  shift        Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, pieceType]) // un log por turno por tipo de presa
  @@index([shiftId])
  @@map("shift_chicken_logs")
}
